# ####################################################################
# Node.js standard gitignore
# ####################################################################

# Dependencies (Never commit these, they should be installed via npm/yarn/pnpm)
node_modules/
jspm_packages/
web_modules/
.pnpm-store/

# Logs and debug files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Local environment files (Contains sensitive API keys, passwords, and tokens)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# DO NOT ignore the example template if you use one
!.env.example

# Testing and Coverage configuration
lib-cov
coverage
*.lcov
.nyc_output

# Build and Compilation outputs (adjust if your framework uses a different folder)
dist/
build/
Release/

# Caches and tooling
.npm
.eslintcache
.stylelintcache
.cache
.parcel-cache
.turbo
.tsbuildinfo

# Framework-specific directories (Next.js, Nuxt.js, Vite, etc.)
.next/
.nuxt/
.output/
out/

# IDE / Editor configurations (Optional but highly recommended)
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# OS generated files
.DS_Store
Thumbs.db
